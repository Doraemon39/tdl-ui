# 临时文件目录（项目规范：所有临时文件放置于 tmp/）
tmp/
/work/
.cache/
*.tmp
*.temp

# Go 构建产物
src/build/bin/
src/.tools/
*.exe
*.syso
*.test
*.pdb

# Test coverage and performance profiles
coverage.out
/coverage/
/src/coverage/
/src/frontend/coverage/
*.prof

# Local runtime databases and SQLite sidecars
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# 前端依赖与构建产物
node_modules/
src/frontend/dist/
src/frontend/wailsjs/

# Wails frontend installation cache (regenerated from package.json)
src/frontend/package.json.md5

# pnpm
.pnpm-store/

# IDE / 编辑器
.idea/
.vscode/
*.swp

# 日志
*.log

# 操作系统
Thumbs.db
.DS_Store

# Portable application data (contains private sessions)
tdl-ui-data/
